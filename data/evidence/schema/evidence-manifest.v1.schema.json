{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sport-tesis.local/schemas/evidence-manifest.v1.schema.json",
  "title": "Manifiesto de evidencia científica (una fuente por archivo)",
  "description": "Contrato v1 de ingesta. Los campos desconocidos se OMITEN; nunca se rellenan con valores inventados. Referencias por claves naturales (ingredient/formulation code, product_id del catálogo, chunk_key, claim_key).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source": { "$ref": "#/$defs/source" },
    "chunks": { "type": "array", "items": { "$ref": "#/$defs/chunk" }, "default": [] },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" }, "default": [] },
    "product_relations": { "type": "array", "items": { "$ref": "#/$defs/productRelation" }, "default": [] },
    "product_ingredients": {
      "description": "Solo para fuentes manufacturer_specification del propio producto (composición declarada).",
      "type": "array", "items": { "$ref": "#/$defs/productIngredient" }, "default": []
    }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$", "maxLength": 120 },
    "code": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 80 },
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "date": { "type": "string", "format": "date" },
    "level": { "enum": ["A", "B", "C", "D"] },
    "timing": { "enum": ["pre", "during", "post", "daily_chronic", "flexible", "not_specified"] },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "source_type", "title"],
      "anyOf": [{ "required": ["doi"] }, { "required": ["pmid"] }, { "required": ["url"] }],
      "properties": {
        "source_key": { "$ref": "#/$defs/key" },
        "source_type": {
          "enum": ["meta_analysis", "systematic_review", "randomized_controlled_trial", "crossover_trial",
                   "non_randomized_trial", "observational_study", "narrative_review", "consensus",
                   "position_stand", "guideline", "official_framework", "manufacturer_specification", "other"]
        },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "authors": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "organization": { "$ref": "#/$defs/nonEmpty" },
        "journal": { "$ref": "#/$defs/nonEmpty" },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "publication_date": { "$ref": "#/$defs/date" },
        "accessed_date": { "$ref": "#/$defs/date" },
        "doi": { "type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$" },
        "pmid": { "type": "string", "pattern": "^[0-9]{1,9}$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "open_access": { "type": "boolean" },
        "license": { "$ref": "#/$defs/nonEmpty" },
        "peer_reviewed": { "type": "boolean" },
        "evidence_level": { "$ref": "#/$defs/level" },
        "evidence_level_rationale": { "$ref": "#/$defs/nonEmpty" },
        "funding": { "$ref": "#/$defs/nonEmpty" },
        "industry_funded": { "type": "boolean" },
        "conflict_of_interest": { "$ref": "#/$defs/nonEmpty" },
        "review_status": { "enum": ["draft", "reviewed", "retired"] },
        "reviewed_by": { "$ref": "#/$defs/nonEmpty" },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "language": { "type": "string", "pattern": "^[a-z]{2}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "source_type": { "const": "manufacturer_specification" } }, "required": ["source_type"] },
          "then": { "properties": { "evidence_level": { "const": "D" } } }
        },
        {
          "if": {
            "properties": {
              "review_status": { "const": "reviewed" },
              "source_type": { "not": { "const": "manufacturer_specification" } }
            },
            "required": ["review_status", "source_type"]
          },
          "then": { "required": ["evidence_level", "evidence_level_rationale"] }
        }
      ]
    },

    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_key", "section", "content"],
      "properties": {
        "chunk_key": { "$ref": "#/$defs/key" },
        "section": {
          "enum": ["abstract", "introduction", "methods", "results", "discussion", "conclusion",
                   "recommendation", "table", "summary", "product_information", "other"]
        },
        "heading": { "$ref": "#/$defs/nonEmpty" },
        "page": { "type": "string", "maxLength": 20 },
        "paragraph": { "type": "string", "maxLength": 20 },
        "content": { "$ref": "#/$defs/nonEmpty" },
        "content_kind": {
          "description": "verbatim = texto literal (solo si la licencia lo permite); excerpt = extracto breve; own_summary = resumen propio.",
          "enum": ["verbatim", "excerpt", "own_summary"]
        }
      }
    },

    "conditions": {
      "description": "Condiciones explícitas de aplicabilidad declaradas por la fuente. No inferir.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_exercise_minutes": { "type": "integer", "minimum": 0 },
        "max_exercise_minutes": { "type": "integer", "minimum": 0 },
        "intensity": { "type": "array", "uniqueItems": true, "items": { "enum": ["low", "moderate", "high", "very_high"] } },
        "environment": { "type": "array", "uniqueItems": true, "items": { "enum": ["heat", "cold", "humid", "altitude", "temperate"] } },
        "sports": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "goals": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "notes": { "type": "string" }
      }
    },

    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_key", "claim_type", "effect_direction", "result_summary"],
      "properties": {
        "claim_key": { "$ref": "#/$defs/key" },
        "claim_type": {
          "enum": ["efficacy", "safety", "dosage_guideline", "timing_guideline", "composition", "usage_instruction", "mechanism"]
        },
        "ingredient": { "$ref": "#/$defs/code" },
        "ingredient_name_raw": { "$ref": "#/$defs/nonEmpty" },
        "formulation": { "$ref": "#/$defs/code" },
        "product_specific": { "type": "boolean" },
        "product_id": { "type": "integer", "minimum": 1 },
        "population": { "$ref": "#/$defs/nonEmpty" },
        "sample_size": { "type": "integer", "minimum": 1 },
        "sex": { "enum": ["male", "female", "mixed", "not_reported"] },
        "training_status": { "enum": ["untrained", "recreationally_active", "trained", "well_trained", "elite", "mixed", "not_reported"] },
        "sport": { "$ref": "#/$defs/nonEmpty" },
        "exercise_context": { "$ref": "#/$defs/nonEmpty" },
        "exercise_duration": { "$ref": "#/$defs/nonEmpty" },
        "exercise_duration_min_minutes": { "type": "integer", "minimum": 0 },
        "exercise_duration_max_minutes": { "type": "integer", "minimum": 0 },
        "dose_text": { "$ref": "#/$defs/nonEmpty" },
        "dose_value": { "type": "number", "minimum": 0 },
        "dose_value_max": { "type": "number", "minimum": 0 },
        "dose_unit": { "$ref": "#/$defs/nonEmpty" },
        "dose_relative": { "$ref": "#/$defs/nonEmpty" },
        "frequency": { "$ref": "#/$defs/nonEmpty" },
        "duration_protocol": { "$ref": "#/$defs/nonEmpty" },
        "timing_context": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/timing" } },
        "timing_details": { "$ref": "#/$defs/nonEmpty" },
        "timing_evidence_strength": { "enum": ["strong", "moderate", "limited", "not_assessed"] },
        "conditions": { "$ref": "#/$defs/conditions" },
        "outcome": { "$ref": "#/$defs/nonEmpty" },
        "effect_direction": { "enum": ["positive", "neutral", "negative", "mixed", "insufficient", "not_applicable"] },
        "effect_size": { "$ref": "#/$defs/nonEmpty" },
        "effect_size_value": { "type": "number" },
        "effect_size_metric": { "$ref": "#/$defs/nonEmpty" },
        "statistical_significance": { "enum": ["significant", "not_significant", "not_tested", "not_reported"] },
        "result_summary": { "$ref": "#/$defs/nonEmpty" },
        "practical_interpretation": { "$ref": "#/$defs/nonEmpty" },
        "limitations": { "$ref": "#/$defs/nonEmpty" },
        "evidence_strength": { "$ref": "#/$defs/level" },
        "conflict_of_interest_notes": { "$ref": "#/$defs/nonEmpty" },
        "review_status": { "enum": ["draft", "reviewed", "retired"] },
        "chunk_keys": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/key" } }
      },
      "allOf": [
        {
          "description": "Composición e instrucciones no evalúan efectos: effect_direction = not_applicable",
          "if": { "properties": { "claim_type": { "enum": ["composition", "usage_instruction"] } } },
          "then": { "properties": { "effect_direction": { "const": "not_applicable" } } },
          "else": { "properties": { "effect_direction": { "not": { "const": "not_applicable" } } } }
        },
        {
          "description": "Eficacia y seguridad requieren el resultado evaluado",
          "if": { "properties": { "claim_type": { "enum": ["efficacy", "safety"] } } },
          "then": { "required": ["outcome"] }
        },
        {
          "description": "La ausencia de significancia no es evidencia negativa",
          "if": {
            "properties": { "effect_direction": { "const": "negative" }, "statistical_significance": { "const": "not_significant" } },
            "required": ["effect_direction", "statistical_significance"]
          },
          "then": false
        },
        {
          "description": "product_specific exige product_id",
          "if": { "properties": { "product_specific": { "const": true } }, "required": ["product_specific"] },
          "then": { "required": ["product_id"] }
        },
        {
          "description": "El claim debe tener un sujeto (ingrediente, formulación o producto), salvo guías generales",
          "if": { "properties": { "claim_type": { "not": { "enum": ["dosage_guideline", "timing_guideline"] } } } },
          "then": { "anyOf": [{ "required": ["ingredient"] }, { "required": ["formulation"] }, { "required": ["product_id"] }] }
        }
      ]
    },

    "productRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "relation_type", "rationale"],
      "properties": {
        "product_id": { "type": "integer", "minimum": 1 },
        "relation_type": { "enum": ["direct_product", "ingredient", "formulation", "category", "manufacturer_specification"] },
        "claim_key": { "$ref": "#/$defs/key" },
        "ingredient": { "$ref": "#/$defs/code" },
        "formulation": { "$ref": "#/$defs/code" },
        "category_id": { "type": "integer", "minimum": 1 },
        "relevance": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "$ref": "#/$defs/nonEmpty" },
        "notes": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "relation_type": { "const": "ingredient" } } }, "then": { "required": ["ingredient"] } },
        { "if": { "properties": { "relation_type": { "const": "formulation" } } }, "then": { "required": ["formulation"] } },
        { "if": { "properties": { "relation_type": { "const": "category" } } }, "then": { "required": ["category_id"] } },
        { "if": { "properties": { "relation_type": { "const": "direct_product" } } }, "then": { "required": ["claim_key"] } }
      ]
    },

    "productIngredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "ingredient"],
      "properties": {
        "product_id": { "type": "integer", "minimum": 1 },
        "ingredient": { "$ref": "#/$defs/code" },
        "amount": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["g", "mg", "ug", "iu", "ml", "ratio"] },
        "basis": { "enum": ["per_serving", "per_100g", "per_unit", "unspecified"] },
        "serving_description": { "type": "string", "maxLength": 100 },
        "form": { "type": "string", "maxLength": 80 },
        "notes": { "type": "string" }
      },
      "dependentRequired": { "amount": ["unit"] }
    }
  }
}
