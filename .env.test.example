PORT=5100
NODE_ENV=test

# PostgreSQL de pruebas (proyecto Supabase separado o Postgres local con pgvector). NUNCA la BD principal.
# Los tests y test/db/setupTestDb.js BORRAN y recrean las tablas de esta base.
TEST_DATABASE_URL=postgresql://postgres.<test-project-ref>:<TEST_DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

JWT_SECRET=test-jwt-secret-sport-thesis-2026
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081

USE_VECTOR_SEARCH=false
# Capa de evidencia científica: NO activar hasta terminar y revisar la ingesta
USE_EVIDENCE_RAG=false
MOCK_LLM=true
MOCK_LLM_DELAY_MS=50
MOCK_EMBEDDINGS=true
LLM_PROVIDER=openai

RATE_LIMIT_MAX_GLOBAL=10000
RATE_LIMIT_MAX_AUTH=1000
RATE_LIMIT_MAX_RECS=1000
