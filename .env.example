PORT=5000
NODE_ENV=development

# PostgreSQL (Supabase) — Dashboard > Connect > Connection string > URI > "Session pooler" (puerto 5432)
# Si la contraseña tiene caracteres especiales (@ : / ? # &) puede ir sin codificar: el backend la interpreta.
DATABASE_URL=postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Opcional: certificado CA de Supabase (Project Settings > Database > SSL) para verificar el servidor
# DATABASE_SSL_CA=./certs/supabase-ca.crt
# Opcional: tamaño del pool de conexiones
# DB_POOL_MAX=10

# Base de datos SOLO para pruebas (otro proyecto Supabase o Postgres local). Nunca la misma que DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres.<test-project-ref>:<TEST_DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# JWT (obligatorio en producción)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS: orígenes permitidos separados por coma (vacío = permisivo en desarrollo)
# CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081

# IA / RAG
USE_VECTOR_SEARCH=true
# Capa de evidencia científica: NO activar hasta terminar y revisar la ingesta
USE_EVIDENCE_RAG=false
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
